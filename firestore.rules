rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/progress/{pokemonId} {
      function validPokemonId(id) {
        return id.matches('^([1-9][0-9]{0,2}|10([01][0-9]|2[0-5]))$');
      }
      function validProgress() {
        return request.resource.data.keys().hasAll(['caught', 'wasOnTeam', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['caught', 'wasOnTeam', 'updatedAt'])
          && request.resource.data.caught is bool
          && request.resource.data.wasOnTeam is bool
          && request.resource.data.updatedAt is timestamp
          && (!request.resource.data.wasOnTeam || request.resource.data.caught);
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && validPokemonId(pokemonId) && validProgress();
      allow delete: if request.auth != null && request.auth.uid == uid && validPokemonId(pokemonId);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
